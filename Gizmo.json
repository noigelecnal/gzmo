    const filename = new URL(url).searchParams.get("f") || "OptiFine.jar";

    const download = typeof GM_download === "function"
        ? GM_download
        : (typeof GM !== "undefined" && typeof GM.download === "function"
            ? GM.download
            : null);

    if (!download) {
        console.error("GM_download/GM.download is not available.");
